# ==============================================================================
# Sterling Wholesale Insurance Portal — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate the values for your environment.

# ------------------------------------------------------------------------------
# 1. Core Application & Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth & JWT Encryption Secrets (Generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# Standard MongoDB connection string (local or MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sterling?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Object Storage (Backblaze B2 / AWS S3 Compatible)
# ------------------------------------------------------------------------------
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=sterling-uploads
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Local upload fallback directory & size limits (in bytes: 10MB = 10485760)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ------------------------------------------------------------------------------
# 4. Email & Notifications (Resend / Nodemailer)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@sterlingwholesaleinsurance.com

# ------------------------------------------------------------------------------
# 5. Two-Factor Authentication (2FA) & Security
# ------------------------------------------------------------------------------
# Set to true to enforce email OTP 2FA for agency logins
ENABLE_2FA=false

# ------------------------------------------------------------------------------
# 6. Address Validation (SmartyStreets)
# ------------------------------------------------------------------------------
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token

# ------------------------------------------------------------------------------
# 7. Additional Integrations
# ------------------------------------------------------------------------------
CUSTOMJS_API_KEY=your_customjs_api_key_optional

